{
  "name": "settings",
  "description": "User preferences and personalization settings for response style, tone, language, and behavior.",
  "risk_tier": "STATEFUL",
  "functions": {
    "set_setting": {
      "description": "Set a user preference (timezone, time_format, spoken_lang)",
      "parameters": {
        "name": { "type": "STRING", "description": "Preference name: timezone, time_format (12h/24h), or spoken_lang (language code like bn, en, es)" },
        "value": { "type": "STRING", "description": "The value for the preference" }
      },
      "required": ["name", "value"],
      "action": "set",
      "target_expr": "{name}",
      "payload_expr": "{value}",
      "templates": ["Set {name} to {value}", "Configure {name} as {value}", "Update my {name} to {value}", "Change my {name} to {value}", "Set my {name} to {value}", "Set {name} to {value} please"],
      "examples": { "name": ["timezone", "time_format", "spoken_lang"], "value": ["Asia/Dhaka", "12h", "24h", "bn", "en", "es"] }
    },
    "delete_setting": {
      "description": "Delete a user preference",
      "parameters": {
        "name": { "type": "STRING", "description": "The preference name to delete" }
      },
      "required": ["name"],
      "action": "delete",
      "target_expr": "{name}",
      "payload_expr": "",
      "templates": ["Delete {name} setting", "Remove {name} preference", "Clear {name}", "Erase {name} setting"],
      "examples": { "name": ["timezone", "time_format", "spoken_lang"] }
    },
    "list_settings": {
      "description": "List all saved user preferences",
      "parameters": {},
      "required": [],
      "action": "get",
      "target_expr": "list",
      "payload_expr": "",
      "templates": ["Show all settings", "List my settings", "What are my preferences?", "Display settings", "Show my preferences", "What settings do I have?"],
      "examples": {}
    }
  }
}
