    "calculate_duration": {
      "description": "Calculate the duration between two dates",
      "parameters": {
        "start_date": { "type": "STRING", "description": "Start date (YYYY-MM-DD)" },
        "end_date": { "type": "STRING", "description": "End date (YYYY-MM-DD)" },
        "unit": { "type": "STRING", "description": "Unit: days, weeks, months, or years (default: days)" }
      },
      "required": ["start_date", "end_date"],
      "action": "get",
      "target": "between",
      "payload_expr": "{start_date} to {end_date} {unit}",
      "templates": ["How many days between {start_date} and {end_date}?", "Duration from {start_date} to {end_date}", "Days between {start_date} and {end_date}", "Calculate weeks between {start_date} and {end_date}"],
      "examples": { "start_date": ["2025-01-10", "2024-06-15", "2025-03-01"], "end_date": ["2025-01-20", "2024-07-15", "2025-03-31"], "unit": ["days", "weeks", "months"] }
    },
    "calculate_time_until": {
      "description": "Calculate how long until a specific time or date",
      "parameters": {
        "target_time": { "type": "STRING", "description": "Target time or date (e.g., 10:00, 10 PM, 2025-12-31)" }
      },
      "required": ["target_time"],
      "action": "get",
      "target": "until",
      "payload_expr": "{target_time}",
      "templates": ["How long until {target_time}?", "Time until {target_time}", "Until {target_time}", "How much time until {target_time}?", "Countdown to {target_time}"],
      "examples": { "target_time": ["10:00", "2 PM", "2025-12-31", "2025-06-30"] }
    },
    "calculate_time_since": {
      "description": "Calculate how long since a specific time or date",
