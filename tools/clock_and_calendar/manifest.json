      "required": ["time"],
      "action": "set",
      "target": "alarm",
      "payload_expr": "{time} {label}",
      "templates": ["Set alarm for {time}", "Set an alarm at {time}", "Wake me up at {time}", "Alarm for {time} called {label}", "Set {time} alarm labeled {label}", "Set alarm 4 {time}"],
      "examples": { "time": ["07:00", "2:30 PM", "06:00", "12:00", "18:30"], "label": ["Wake up", "Meeting", "Lunch", "Medication", ""] }
    },
