      },
      "required": ["past_time"],
      "action": "get",
      "target": "since",
      "payload_expr": "{past_time}",
      "templates": ["How long since {past_time}?", "Time since {past_time}", "Since {past_time}", "How much time has passed since {past_time}?"],
      "examples": { "past_time": ["08:00", "2025-01-01", "2024-06-01"] }
    },
    "calculate_date_offset": {
      "description": "Calculate a date offset by days from the current date",
      "parameters": {
        "date": { "type": "STRING", "description": "Base date (YYYY-MM-DD) or offset like +7 days" },
        "offset": { "type": "STRING", "description": "Optional: +/- days/weeks/months" }
      },
      "required": ["date"],
      "action": "get",
      "target": "date_offset",
      "payload_expr": "{date} {offset}",
      "templates": ["What is {offset} from {date}?", "Date offset: {offset} from {date}", "Add {offset} to {date}", "{offset} from today", "What is {offset} from today?"],
      "examples": { "date": ["2025-01-15", "2025-06-01", "2025-12-25"], "offset": ["+7 days", "-3 days", "+1 month", "+2 weeks"] }
    },
