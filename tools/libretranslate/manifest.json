{
  "name": "libretranslate",
  "description": "Self-hosted machine translation. Translate between 50+ languages via LibreTranslate. Supports detect and translate.",
  "risk_tier": "NETWORK",
  "functions": {
    "translate_text": {
      "description": "Translate text from one language to another",
      "parameters": {
        "text": { "type": "STRING", "description": "The text to translate" },
        "target_lang": { "type": "STRING", "description": "Target language code (e.g., fr, bn, ja, de, es, ar, hi)" },
        "source_lang": { "type": "STRING", "description": "Optional source language code or 'auto' for auto-detect (default: auto)" }
      },
      "required": ["text", "target_lang"],
      "action": "translate",
      "target_expr": "{target_lang}",
      "payload_expr": "{text} | {source_lang}",
      "templates": ["Translate '{text}' to {target_lang}", "What is '{text}' in {target_lang}?", "Translate '{text}' into {target_lang}", "How do you say '{text}' in {target_lang}?", "Say '{text}' in {target_lang}", "{text} in {target_lang} please", "What's the {target_lang} word for '{text}'?", "Convert '{text}' to {target_lang}", "Put '{text}' into {target_lang}", "tranzlate '{text}' 2 {target_lang}", "say '{text}' in {target_lang} plz", "whts '{text}' in {target_lang}"],
      "examples": { "text": ["Hello world", "Good morning", "How are you?", "Thank you", "Please help me", "Nice to meet you"], "target_lang": ["fr", "bn", "es", "de", "ja", "ar", "hi"], "source_lang": ["en", "auto", "", "fr"] }
    },
    "detect_language": {
      "description": "Detect the language of a piece of text",
      "parameters": {
        "text": { "type": "STRING", "description": "The text to detect the language of" }
      },
      "required": ["text"],
      "action": "detect",
      "target_expr": "",
      "payload_expr": "{text}",
      "templates": ["What language is '{text}'?", "Detect the language: '{text}'", "Identify the language of '{text}'", "Tell me what language this is: '{text}'", "Which language is '{text}'?", "wht lang iz '{text}'"],
      "examples": { "text": ["Bonjour le monde", "Hola mundo", "Guten Tag", "Ciao mondo", "こんにちは"] }
    },
    "list_languages": {
      "description": "List available translation languages or installed models",
      "parameters": {
        "scope": { "type": "STRING", "description": "Optional: 'languages' for all available, 'installed' for only installed models (default: languages)" }
      },
      "required": [],
      "action": "list",
      "target_expr": "{scope}",
      "payload_expr": "",
      "templates": ["List all languages", "Show me languages", "What languages do I have?", "Display available languages", "What languages are available?", "List installed", "Show installed models", "wat languages u got"],
      "examples": { "scope": ["languages", "installed"] }
    }
  }
}
