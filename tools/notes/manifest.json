{
  "name": "notes",
  "description": "CRUD for .md notes in memory/notes/. Supports line-level editing, timestamps, and find/replace.",
  "risk_tier": "STATEFUL",
  "functions": {
    "list_notes": {
      "description": "List all saved notes with file sizes and modification dates",
      "parameters": {},
      "required": [],
      "action": "list",
      "target_expr": "",
      "payload_expr": "",
      "templates": ["List my notes", "Show me my notes", "What notes do I have?", "Display all notes", "Show all notes", "List all notes", "Give me my notes", "What notes are saved?"],
      "examples": {}
    },
    "read_note": {
      "description": "Read the contents of a note",
      "parameters": {
        "filename": { "type": "STRING", "description": "The note filename (without .md extension)" },
        "lines": { "type": "STRING", "description": "Optional line number or range (e.g., 3 or 3-5)" }
      },
      "required": ["filename"],
      "action": "read",
      "target_expr": "{filename}",
      "payload_expr": "{lines}",
      "templates": ["Read {filename}", "Open {filename}", "Show me {filename}", "View {filename}", "Display {filename}", "Let me see {filename}", "Pull up {filename}", "Show the content of {filename}"],
      "examples": { "filename": ["groceries", "todo", "notes", "meeting-notes", "reminders"], "lines": ["", "3", "3-5"] }
    },
    "save_note": {
      "description": "Save content to a new or existing note",
      "parameters": {
        "content": { "type": "STRING", "description": "The content to save" },
        "filename": { "type": "STRING", "description": "Optional filename (without .md). Auto-generated from first 3 words if omitted" }
      },
      "required": ["content"],
      "action": "save",
      "target_expr": "{filename}",
      "payload_expr": "{content}",
      "templates": ["Save: {content}", "Remember: {content}", "Make a note: {content}", "Take note: {content}", "Save this: {content}", "Record: {content}", "Keep this: {content}", "Jot this down: {content}", "Note this down: {content}", "Capture this: {content}", "Put this in a note: {content}", "Save to {filename}: {content}", "Create note {filename} with {content}", "Write {filename}: {content}", "remembr: {content}", "dont 4get: {content}", "write dis down: {content}"],
      "examples": { "content": ["Buy milk and eggs", "Finish report", "Call dentist", "meeting at 3pm tomorrow", "project deadline is Friday", "buy milk and eggs on the way home", "Sarah's birthday is on March 15th"], "filename": ["groceries", "todo", "reminders", "meeting-notes", ""] }
    },
    "append_note": {
      "description": "Append content to the end of an existing note",
      "parameters": {
        "filename": { "type": "STRING", "description": "The note filename (without .md extension)" },
        "content": { "type": "STRING", "description": "Content to append to the note" }
      },
      "required": ["filename", "content"],
      "action": "append",
      "target_expr": "{filename}",
      "payload_expr": "{content}",
      "templates": ["Append to {filename}: {content}", "Add to {filename}: {content}", "Add more to {filename}: {content}", "Update {filename} with {content}", "Insert into {filename}: {content}", "Add this to {filename}: {content}", "Extend {filename} with {content}"],
      "examples": { "filename": ["groceries", "todo", "notes"], "content": ["Milk, eggs, bread", "Buy groceries, call dentist", "Finish report, email team"] }
    },
    "delete_note": {
      "description": "Delete an entire note file or specific lines",
      "parameters": {
        "filename": { "type": "STRING", "description": "The note filename to delete (without .md)" },
        "lines": { "type": "STRING", "description": "Optional: line number or range to delete instead of the whole file" }
      },
      "required": ["filename"],
      "action": "delete",
      "target_expr": "{filename}",
      "payload_expr": "{lines}",
      "templates": ["Delete {filename}", "Remove {filename}", "Clear {filename}", "Erase {filename}", "Get rid of {filename}", "Trash {filename}", "Discard {filename}", "del {filename}", "remov {filename}"],
      "examples": { "filename": ["groceries", "todo", "temp"], "lines": ["", "3", "3-5"] }
    },
    "replace_in_note": {
      "description": "Find and replace text in a note",
      "parameters": {
        "filename": { "type": "STRING", "description": "The note filename" },
        "old_text": { "type": "STRING", "description": "The text to find and replace" },
        "new_text": { "type": "STRING", "description": "The replacement text" }
      },
      "required": ["filename", "old_text", "new_text"],
      "action": "change",
      "target_expr": "{filename}",
      "payload_expr": "{old_text} -> {new_text}",
      "templates": ["In {filename}: replace {old_text} with {new_text}", "Change {old_text} to {new_text} in {filename}", "Update {filename}: {old_text} -> {new_text}", "Modify {filename}: replace {old_text} with {new_text}"],
      "examples": { "filename": ["groceries", "todo"], "old_text": ["milk", "banana", "eggs"], "new_text": ["oat milk", "apple", "tofu"] }
    },
    "edit_note_line": {
      "description": "Replace or insert a specific line in a note",
      "parameters": {
        "filename": { "type": "STRING", "description": "The note filename" },
        "line_number": { "type": "STRING", "description": "Line number to replace, or +N to insert before line N" },
        "content": { "type": "STRING", "description": "The new content for the line" }
      },
      "required": ["filename", "line_number", "content"],
      "action": "change",
      "target_expr": "{filename}",
      "payload_expr": "{line_number} | {content}",
      "templates": ["In {filename}: change line {line_number} to {content}", "Edit line {line_number} of {filename}: {content}", "Update {filename} line {line_number}: {content}"],
      "examples": { "filename": ["groceries", "todo"], "line_number": ["3", "+2", "1"], "content": ["Buy oat milk", "Call dentist tomorrow", "Finish report"] }
    },
    "rename_note": {
      "description": "Rename a note file",
      "parameters": {
        "old_name": { "type": "STRING", "description": "Current note filename (without .md)" },
        "new_name": { "type": "STRING", "description": "New note filename (without .md)" }
      },
      "required": ["old_name", "new_name"],
      "action": "rename",
      "target_expr": "{old_name}",
      "payload_expr": "{new_name}",
      "templates": ["Rename {old_name} to {new_name}", "Change {old_name} name to {new_name}", "Rename {old_name} as {new_name}", "Relabel {old_name} to {new_name}"],
      "examples": { "old_name": ["oldnote", "temp", "draft"], "new_name": ["newnote", "permanent", "final"] }
    },
    "search_notes": {
      "description": "Search notes for a keyword in filenames and content",
      "parameters": {
        "query": { "type": "STRING", "description": "The search keyword or phrase" },
        "filename": { "type": "STRING", "description": "Optional: restrict search to a specific note" }
      },
      "required": ["query"],
      "action": "search",
      "target_expr": "{filename}",
      "payload_expr": "{query}",
      "templates": ["Search for {query}", "Find {query}", "Look up {query}", "Search {filename} for {query}", "Find {query} in {filename}", "Dig up {query}", "Locate {query}", "find {query}", "look 4 {query}", "seach {query}"],
      "examples": { "query": ["groceries", "meeting", "call", "birthday"], "filename": ["", "todo", "notes"] }
    }
  }
}
