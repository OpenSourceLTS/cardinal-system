{
  "name": "llm",
  "description": "Routes user input to the main AI model for conversation, instruction, or complex queries. All user history is available to the AI.",
  "risk_tier": "NETWORK",
  "actions": [
    "forward"
  ],
  "target_hint": "ai (for AI processing)",
  "payload_hint": "user message text to forward to AI",
  "manifest": {
    "example": {
      "action": "forward",
      "target": "ai",
      "payload": "Tell me a story about space"
    },
    "a@p": {
      "forward": [
        [
          "ai",
          "user message to forward to the AI"
        ]
      ]
    }
  },
  "templates": {
    "forward": {
      "en": [
        "Forward this to the AI: {payload}",
        "Send to AI: {payload}",
        "Ask the AI: {payload}",
        "Pass this to the AI: {payload}",
        "Let the AI handle this: {payload}",
        "Tell the AI {payload}",
        "Route to AI: {payload}",
        "Forward to AI for: {payload}"
      ]
    }
  },
  "payload_examples": {
    "ai": [
      "tell me a story about space",
      "what is the meaning of life",
      "explain quantum physics simply",
      "write a poem about the ocean",
      "what are the benefits of meditation",
      "how do I learn a new language",
      "tell me about the history of Rome",
      "what is machine learning",
      "give me advice on public speaking",
      "explain how photosynthesis works"
    ]
  },
